{
  "name": "illust-blend-filter",
  "productName": "IllustBlend",
  "version": "0.3.0",
  "description": "배경에 어우러지게 일러스트에 필터 레이어를 얹는 프로그램",
  "main": "main.js",
  "author": "IllustBlend",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "local.illustblend",
    "productName": "IllustBlend",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "IllustBlend-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  }
}
